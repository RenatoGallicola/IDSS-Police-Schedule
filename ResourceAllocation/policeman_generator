import csv
import random
from faker import Faker
from location_generator import Location

fake = Faker()

# Number of policemen to generate
tot_pol = 1000

def generate_coordinates():
    return round(random.uniform(Location.MINLAT.value, Location.MAXLAT.value), Location.PRECISION.value), \
        round(random.uniform(Location.MINLONG.value, Location.MAXLONG.value), Location.PRECISION.value)

# Header: 'Full Name', 'Home Address Latitude', 'Home Address Longitude'
with open('ResourceAllocation/policeman_data.csv', mode='w', newline='') as file:
    writer = csv.writer(file)
    
    for _ in range(tot_pol):
        full_name = fake.name()
        longitude, latitude = generate_coordinates()
        writer.writerow([full_name, longitude, latitude])